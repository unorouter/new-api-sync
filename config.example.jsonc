{
  "target": {
    "baseUrl": "https://api.unorouter.ai",
    "systemAccessToken": "target-system-access-token",
    "userId": 1
    // "targetPrefix": "prod"
  },

  // Global: model types to test during sync (default: ["text"])
  // "testModelTypes": ["text", "image"],

  "blacklist": ["kiro", "nsfw"],
  "modelMapping": {
    "claude-sonnet-4-5-20250929-thinking": "claude-sonnet-4-5-20250929"
  },

  "providers": [
    // ── new-api upstream ──
    {
      "type": "newapi",
      "name": "upstream-main",
      "baseUrl": "https://www.newapi.ai",
      "systemAccessToken": "upstream-system-access-token",
      "userId": 1,
      "enabledVendors": ["anthropic", "openai"],
      "enabledModels": ["claude-*-4-5*", "gpt-5*"],
      // "testModelTypes": ["text", "image"],  // override global
      "priceAdjustment": -0.67
    },

    // ── Direct vendor API ──
    {
      "type": "direct",
      "name": "kimi-code",
      "baseUrl": "https://api.kimi.com/coding",
      "apiKey": "sk-kimi-...",
      "vendor": "moonshot",
      "models": ["kimi-for-coding"]
      // "enabledModels": ["kimi-*"],      // glob filter (when using auto-discovery instead of explicit models)
      // "channelType": 14,                // override inferred channel type
      // "ratio": 0.5,                     // base group ratio (default 1.0)
      // "discoverEndpoint": "/v1/models", // custom discovery endpoint
      // priceAdjustment as object: keyed by model glob, vendor, model type, or "default"
      // "priceAdjustment": { "default": -0.3, "image": 0.5 }
    },

    // ── sub2api (with admin key, auto-discovers groups) ──
    {
      "type": "sub2api",
      "name": "sub2api-fallback",
      "baseUrl": "https://sub2api.unorouter.ai",
      "adminApiKey": "admin-api-key"
      // Or use explicit groups instead of adminApiKey:
      // "groups": [
      //   { "key": "sk-...", "platform": "anthropic" },
      //   { "key": "sk-...", "platform": "openai", "name": "my-openai" }
      // ],
      // "enabledVendors": ["anthropic"],
      // "enabledModels": ["claude-*"]
    }

    // ── NVIDIA NIM (requires https://github.com/unorouter/new-api fork) ──
    // {
    //   "type": "nvidia",
    //   "name": "nvidia-nim",
    //   "apiKey": "nvapi-...",
    //   // "baseUrl": "https://integrate.api.nvidia.com",       // text models (default)
    //   // "imageBaseUrl": "https://ai.api.nvidia.com",          // image models (default)
    //   // "models": ["meta/llama-3.3-70b-instruct"],            // explicit list (skips discovery)
    //   // "enabledModels": ["meta/*", "stabilityai/sd3-turbo"], // image model names are auto-added
    //   // "ratio": 1.0
    // }
  ]
}
