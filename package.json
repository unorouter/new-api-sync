{
  "name": "new-api-sync",
  "version": "0.5.0",
  "description": "Declarative multi-provider sync for new-api instances",
  "type": "module",
  "private": true,
  "scripts": {
    "sync": "bun run src/cli/index.ts",
    "dev": "bun --watch run src/server/route.ts 2>&1 | tee /tmp/next.log",
    "ui": "bun run src/cli/index.ts ui",
    "typecheck": "tsc",
    "build": "bun run src/build.ts",
    "prettier": "prettier --write ."
  },
  "dependencies": {
    "@base-ui/react": "1.4.1",
    "@elysiajs/eden": "1.4.9",
    "@elysiajs/static": "1.4.10",
    "@hookform/resolvers": "5.2.2",
    "@sinclair/typebox": "0.34.49",
    "@tanstack/react-query": "5.100.6",
    "ansi_up": "6.0.6",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "commander": "14.0.3",
    "consola": "3.4.2",
    "country-flag-icons": "1.6.16",
    "elysia": "1.4.28",
    "fast-equals": "6.0.0",
    "lucide-react": "1.14.0",
    "micromatch": "4.0.8",
    "ofetch": "1.5.1",
    "p-limit": "7.3.0",
    "react": "19.2.5",
    "react-dom": "19.2.5",
    "react-hook-form": "7.74.0",
    "remove-markdown": "0.6.3",
    "safe-stable-stringify": "2.5.0",
    "shadcn": "4.6.0",
    "sonner": "2.0.7",
    "tailwind-merge": "3.5.0",
    "tw-animate-css": "1.4.0",
    "use-intl": "4.11.0",
    "yaml": "2.8.3",
    "zustand": "5.0.12"
  },
  "devDependencies": {
    "@types/bun": "1.3.13",
    "@types/micromatch": "4.0.10",
    "@types/node": "25.6.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/remove-markdown": "0.3.4",
    "bun-plugin-tailwind": "0.1.2",
    "prettier": "3.8.3",
    "prettier-plugin-tailwindcss": "0.8.0",
    "tailwindcss": "4.2.4"
  },
  "peerDependencies": {
    "typescript": "6.0.3"
  }
}
